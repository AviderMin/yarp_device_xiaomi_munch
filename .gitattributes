# This device tree is edited on Windows and built on Linux (repo + mka).
# Normalise every text file to LF so a Windows checkout never lands CRLF
# in the .mk/.rc/.fstab/.flags files that the Linux build consumes.
* text=auto eol=lf

# Binary payloads must never be converted (belt and braces on top of text=auto).
*.bin   binary
*.so    binary
*.img   binary
*.apk   binary
# The kernel payload is named exactly "Image" (no extension), so text=auto cannot
# classify it by suffix; mark the path explicitly.
prebuilt/Image binary

# The split-MBN TrustZone images (.mdt/.b00..b07) carry no recognised binary
# suffix either, and text=auto would otherwise inspect them file by file. They
# sit in the recovery ramdisk at /vendor/firmware_mnt/image and are loaded
# verbatim by QSEECom, so pin the whole directory.
recovery/root/vendor/firmware_mnt/image/** binary

# Same for the recovery vendor executables: qseecomd, keymasterd and the
# keymaster/gatekeeper HALs under bin/hw have no extension at all.
recovery/root/vendor/bin/** binary
