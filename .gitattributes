# This device tree is edited on Windows and built on Linux (repo + mka).
# Normalise every text file to LF so a Windows checkout never lands CRLF
# in the .mk/.rc/.fstab/.flags files that the Linux build consumes.
* text=auto eol=lf

# Binary payloads must never be converted (belt and braces on top of text=auto).
*.bin   binary
*.so    binary
*.img   binary
*.apk   binary
# The kernel payload is named exactly "Image" (no extension), so text=auto cannot
# classify it by suffix; mark the path explicitly.
prebuilt/Image binary
