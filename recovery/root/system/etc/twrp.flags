# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point       fstype  device                        device2                flags

/boot               emmc    /dev/block/bootdevice/by-name/boot                   flags=slotselect;display="Boot Image";backup=1;flashimg=1
/vendor_boot        emmc    /dev/block/bootdevice/by-name/vendor_boot            flags=slotselect;display="Vendor_Boot Image";backup=1;flashimg=1
/dtbo               emmc    /dev/block/bootdevice/by-name/dtbo                   flags=slotselect;display="DTBo Image";backup=1;flashimg=1
/splash           	emmc    /dev/block/bootdevice/by-name/splash                 flags=display="Splash Image";flashimg=1;backup=1

/cust               ext4    /dev/block/bootdevice/by-name/cust                   flags=display="Cust";backup=0
/cust_image         emmc    /dev/block/bootdevice/by-name/cust                   flags=display="Cust Image";backup=1;flashimg=1

# AVB Partition
/vbmeta             emmc    /dev/block/bootdevice/by-name/vbmeta                 flags=slotselect;display="VBMeta Image";backup=1;flashimg=1
/vbmeta_system      emmc    /dev/block/bootdevice/by-name/vbmeta_system		     flags=slotselect;display="VBMeta_System Image";backup=1;flashimg=1

# Modem Partition
/modem              emmc    /dev/block/bootdevice/by-name/modem                  flags=slotselect;display="Modem Image";backup=1;flashimg=1
/bluetooth          emmc    /dev/block/bootdevice/by-name/bluetooth              flags=slotselect;backup=1;subpartitionof=/modem
/dsp                emmc    /dev/block/bootdevice/by-name/dsp                    flags=slotselect;backup=1;subpartitionof=/modem

# EFS Partition
/efs1               emmc    /dev/block/bootdevice/by-name/modemst1               flags=backup=1;display=EFS
/efs2               emmc    /dev/block/bootdevice/by-name/modemst2               flags=backup=1;subpartitionof=/efs1
/efsc               emmc    /dev/block/bootdevice/by-name/fsc                    flags=backup=1;subpartitionof=/efs1
/efsg               emmc    /dev/block/bootdevice/by-name/fsg                    flags=backup=1;subpartitionof=/efs1

# Userdata & metadata (FBE / metadata encryption, wrapped keys via keymaster)
/data            auto    /dev/block/bootdevice/by-name/userdata             flags=display="Data";storage;wipeingui;backup=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/metadata         ext4    /dev/block/bootdevice/by-name/metadata               flags=display="Metadata";wrappedkey;backup=0;wipeingui
/firmware         vfat    /dev/block/bootdevice/by-name/modem                    flags=display="Firmware";mounttodecrypt;slotselect;fsflags="ro,shortname=lower"

# Persistent Firmware & Properties
/persist            ext4    /dev/block/bootdevice/by-name/persist                flags=display="Persist"
/persist_image      emmc    /dev/block/bootdevice/by-name/persist                flags=display="Persist Image";backup=1;flashimg=1

# Removable storage
# USB mass storage: the UFS LUNs already occupy sda..sdf (6 LUNs), so an OTG
# stick enumerates as sdg / sdg1. A literal "auto" fstype is only resolved by
# blkid inside TWPartition::Check_FS_Type() when the media is actually present;
# with nothing plugged in it is passed to mount(2) verbatim, which makes the
# kernel request a non-existent "fs-auto" module (dmesg: "request_module
# fs-auto succeeded, but still no fs?"). Pin vfat for that no-media path --
# with media attached blkid still overrides it with the real filesystem.
/usb_otg            vfat    /dev/block/sdg1        /dev/block/sdg                flags=fsflags=utf8;display="USB-OTG";storage;wipeingui;removable
