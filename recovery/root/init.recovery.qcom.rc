on early-init
    # Bind the ramdisk's vendor libraries where TWRP's later mount of the real
    # vendor partition over /vendor cannot shadow them (taro pattern). The
    # security services below search /vendor_lib64 first.
    mkdir /vendor_lib64 0755 root root
    mount none /vendor/lib64 /vendor_lib64 bind

on init
    write /sys/class/backlight/panel0-backlight/brightness 200

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    # write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Qualcomm secure services (required for FBE / metadata decryption).
    # The keymaster/gatekeeper TrustZone apps (keymaster64.mdt etc.) live in the
    # modem partition. QSEECom_start_app() does NOT open() them -- it issues
    # request_firmware(), which the kernel firmware loader resolves through
    # ueventd. recovery/root/vendor/etc/ueventd.rc declares
    # /vendor/firmware_mnt/image as a firmware directory and the force_sysfs_
    # fallback write below routes the request to ueventd. Mount the modem
    # partition there once; there is no wait for individual TA files because the
    # loader, not init, reads them.
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    wait /dev/block/bootdevice/by-name/modem 10
    mkdir /vendor/firmware_mnt 0755 root root
    mount vfat /dev/block/bootdevice/by-name/modem /vendor/firmware_mnt ro shortname=lower
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom

    # qseecomd's RPMB/SSD listeners need the UFS by-name links; wait for one
    # before starting so the first start succeeds (taro pattern).
    wait /dev/qseecom
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd

    # vibrator
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/f0_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/osc_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/3-005a/osc_save
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/2-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/3-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/3-005a/custom_wave
    chmod 0666 /sys/class/qcom-haptics/lra_calibration
    chown system system /sys/bus/i2c/drivers/aw8697_haptic/0-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/0-005a/custom_wave
    chmod 0666 /sys/class/qcom-haptics/lra_impedance
    chown system system /sys/bus/i2c/drivers/awinic_haptic/3-005a/f0_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/3-005a/osc_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/3-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/3-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/awinic_haptic/3-005a/f0_value
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/3-005a/f0_value
    chown system system /sys/bus/i2c/drivers/awinic_haptic/3-005a/nv_flag
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/3-005a/nv_flag
    chmod 0666  /sys/bus/i2c/drivers/aw8697_haptic/5-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/5-005a/custom_wave

service vibratorfeature-hal-service /vendor/bin/hw/vendor.xiaomi.hardware.vibratorfeature.service
    class hal
    user system
    group system input
    seclabel u:r:recovery:s0
    onrestart restart vibratorfeature

# Qualcomm secure services. Recovery never imports the stock vendor init scripts
# (stock/vendor/etc/init/*.rc), so the services the stock vendor used to declare
# have to be defined here. The binaries are prebuilts shipped inside the recovery
# ramdisk at /system/bin; their HIDL/AIDL libraries are already pulled into the
# recovery image by bootable/recovery/prebuilt/Android.mk.
service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    seclabel u:r:recovery:s0

# keymasterd keeps the keymaster TA alive and services vendor.qti.qseecom
# requests; stock starts it on late-fs (stock/vendor/etc/init/keymasterd.rc).
service vendor.keymasterd /vendor/bin/keymasterd
    class core
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    class hal
    user system
    group system drmrpc
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class hal
    user system
    group system drmrpc
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    setenv LD_LIBRARY_PATH /vendor_lib64:/vendor_lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

# Start the HIDL HALs only once qseecomd has registered its QSEE listeners and
# hwservicemanager is up (taro pattern). vendor.sys.listeners.registered is set
# by qseecomd itself; without this gate the HALs call QSEECom_start_app before
# QSEE is ready and crash-loop.
on property:hwservicemanager.ready=true && property:vendor.sys.listeners.registered=true
    start gatekeeper-1-0
    start keymaster-4-0
    start vendor.keymasterd

on post-fs
    start boot-hal-1-1

on boot
    start health-hal-2-1
    start vibratorfeature-hal-service
